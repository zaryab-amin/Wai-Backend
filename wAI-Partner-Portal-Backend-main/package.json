{
  "name": "QuizApp",
  "version": "1.0.0",
  "description": "Server for quiz app",
  "author": "haris",
  "main": "src/index.js",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=8",
    "yarn": "*"
  },
  "scripts": {
    "docker": "node ./src/index.js",
    "start:local": "env-cmd -f .env node ./src/index.js",
    "precommit": "yarn lint",
    "prestart": "yarn docs",
    "start": "cross-env NODE_ENV=production pm2 start ./src/index.js",
    "dev": "nodemon --inspect ./src/index.js",
    "migrate:prescient": "node ./src/scripts/prescient-migration.js",
    "lint": "eslint ./src/ --ignore-path .gitignore --ignore-pattern internals/scripts",
    "lint:fix": "yarn lint --fix",
    "lint:watch": "yarn lint --watch",
    "test": "cross-env NODE_ENV=test nyc --reporter=html --reporter=text mocha --timeout 20000 --exit --recursive src/api/tests",
    "test:unit": "cross-env NODE_ENV=test mocha src/api/tests/unit",
    "test:integration": "cross-env NODE_ENV=test mocha --timeout 20000 --exit src/api/tests/integration",
    "test:watch": "cross-env NODE_ENV=test mocha --watch src/api/tests/unit"
  },
  "keywords": [
    "express",
    "node",
    "node.js",
    "mongodb",
    "mongoose",
    "passport",
    "es6",
    "es7",
    "es8",
    "es2017",
    "mocha",
    "istanbul",
    "nyc",
    "eslint",
    "Travis CI",
    "coveralls",
    "REST",
    "API",
    "boilerplate",
    "generator",
    "starter project"
  ],
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.458.0",
    "@aws-sdk/client-s3": "^3.454.0",
    "@aws-sdk/s3-request-presigner": "^3.454.0",
    "@azure/msal-node": "^3.8.0",
    "@google-cloud/storage": "^7.17.3",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.6.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "2.4.3",
    "bluebird": "^3.5.0",
    "body-parser": "^1.17.0",
    "compression": "^1.6.2",
    "cookie": "^0.5.0",
    "cookie-parser": "^1.4.6",
    "cookie-session": "^2.0.0",
    "cors": "^2.8.3",
    "cross-env": "^7.0.3",
    "crypto": "^1.0.1",
    "dompurify": "^3.0.6",
    "dotenv": "^17.2.0",
    "dotenv-safe": "^8.2.0",
    "ejs": "^3.1.9",
    "email-templates": "^11.1.1",
    "express": "^4.15.2",
    "express-session": "^1.17.3",
    "express-validation": "^4.1.0",
    "ffprobe": "^1.1.2",
    "ffprobe-static": "^3.1.0",
    "handlebars": "^4.7.8",
    "helmet": "^4.6.0",
    "html2pdf.js": "^0.10.1",
    "http-status": "^1.0.1",
    "joi": "^17.12.2",
    "jsdom": "^22.1.0",
    "jsonwebtoken": "^9.0.0",
    "jwt-simple": "0.5.6",
    "lodash": "^4.17.4",
    "method-override": "^3.0.0",
    "moment-timezone": "^0.5.13",
    "mongoose": "^5.13.20",
    "morgan": "^1.8.1",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.1.6",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.3.1",
    "openai": "^4.28.0",
    "passport": "^0.6.0",
    "passport-azure-ad-oauth2": "^0.0.4",
    "passport-google-oauth20": "^2.0.0",
    "passport-http-bearer": "^1.0.1",
    "passport-jwt": "^4.0.1",
    "pm2": "^5.3.0",
    "pug": "^3.0.1",
    "raw-body": "^3.0.0",
    "stripe": "^13.6.0",
    "uuid": "3.4.0",
    "winston": "^3.1.0",
    "xss": "^1.0.14"
  },
  "devDependencies": {
    "apidoc": "^1.2.0",
    "chai": "^4.1.0",
    "chai-as-promised": "^7.1.1",
    "coveralls": "^3.0.0",
    "eslint": "^7.29.0",
    "eslint-config-airbnb-base": "^14.2.0",
    "eslint-plugin-import": "^2.2.0",
    "mocha": "^10.2.0",
    "nodemon": "^3.0.1",
    "nyc": "^15.1.0",
    "opn-cli": "^1.0.0",
    "supertest": "^6.1.3"
  }
}
